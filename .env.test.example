# Copy to `.env.test` before running `npm run test:e2e`.
#
# This MUST point at a different database from `.env`. The manager scenario
# suspends a seller and republishes listings; run against the database that
# serves your demo and it will leave a reviewer looking at a suspended
# participant and half a catalogue.
#
# On Neon, a second database in the same project is enough and free:
#   CREATE DATABASE n5deal_test;
# then apply the schema with:
#   node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/n5deal_test?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/n5deal_test?sslmode=require"

AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Left empty on purpose. Every AI feature has a deterministic path underneath it,
# and the suite exercises that path — a green run proves the app works with no
# model available.
GEMINI_API_KEY=""
