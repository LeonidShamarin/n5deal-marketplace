# Copy to `.env` and fill in. Nothing here is required except DATABASE_URL/DIRECT_URL
# and AUTH_SECRET — the app runs fully without an AI key.

# ---- Database (Postgres; Neon recommended — free tier, no card) ----
# DATABASE_URL  — pooled connection, used by the app at runtime (serverless-safe).
# DIRECT_URL    — direct connection, used by `prisma migrate` (the pooler cannot run DDL).
# On Neon both strings are on the dashboard: "Connection pooling" toggles between them.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ---- Auth (Auth.js v5) ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ---- AI (optional) ----
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
# Used for NL search, listing validation and match explanations.
# If empty, each of those falls back to a deterministic implementation.
GEMINI_API_KEY=""
